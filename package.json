{
    "name": "node-crc",
    "version": "5.0.0",
    "description": "To compute CRC values by providing the length of bits, expression, reflection, an initial value and a final xor value. It has many built-in CRC functions.",
    "keywords": [
        "crc",
        "crc16",
        "crc32",
        "crc64",
        "crc8",
        "node.js"
    ],
    "homepage": "https://magiclen.org/node-js-crc/",
    "bugs": {
        "url": "https://github.com/magiclen/node-crc/issues"
    },
    "license": "MIT",
    "author": "Magic Len",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/magiclen/node-crc.git"
    },
    "files": [
        "lib",
        "src/**/*.rs",
        "build.rs",
        "build.js",
        "Cargo.toml",
        "Cargo.lock"
    ],
    "type": "module",
    "types": "./lib/index.d.ts",
    "exports": "./lib/index.js",
    "scripts": {
        "test": "tsx --test",
        "clean": "rimraf lib native",
        "build": "npm run clean && npm run install && tsc -p tsconfig.build.json",
        "build:watch": "npm run build -- -w",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "knip": "knip",
        "check": "npm run lint && npm run format:check && npm run knip",
        "prepare": "node setup-git-hooks.mjs",
        "prepack": "npm run build",
        "prepublishOnly": "npm run check && npm run test",
        "install": "napi build --release --platform --output-dir native --js index.cjs --dts index.d.cts --format commonjs -- --locked && node build.js"
    },
    "dependencies": {
        "@napi-rs/cli": "^3.10.5"
    },
    "devDependencies": {
        "@types/node": "^26.6.3",
        "knip": "^6.38.0",
        "oxfmt": "^0.71.0",
        "oxlint": "^1.86.0",
        "oxlint-tsgolint": "^7.0.2003",
        "rimraf": "^6.1.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=24"
    }
}
